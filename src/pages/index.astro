---
import BaseLayout from '../layouts/BaseLayout.astro';
import TagCloud from '../components/TagCloud.astro';
import { getPublishedArticles, getTagCounts } from '../lib/content';

const articles = (await getPublishedArticles()).slice(0, 5);
const tagCounts = await getTagCounts();
---
<BaseLayout title="One You">
  <div class="hero">
    <h1>One You.</h1>
    <p>A modern Adlerian take on attending to yourself — health, wealth, and purpose — so you can contribute from a full cup.</p>
  </div>

  <section style="margin-bottom: 2.5rem;">
    <h2 style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 1rem;">Explore by topic</h2>
    <TagCloud tags={tagCounts} />
  </section>

  <section>
    <h2 style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 1rem;">Recent writing</h2>
    <ul class="article-list">
      {articles.map(article => (
        <li class="article-item">
          <h2><a href={`/articles/${article.slug}`}>{article.data.title}</a></h2>
          <div class="article-meta">{article.data.date}</div>
          {article.data.description && <p class="article-desc">{article.data.description}</p>}
        </li>
      ))}
    </ul>
    <p style="margin-top: 1.5rem;"><a href="/articles">All articles →</a></p>
  </section>
</BaseLayout>
